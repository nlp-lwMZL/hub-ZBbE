{"uid": "74a3f6a985380e7ae3c5899df10f563c", "text": "美国网件（NETGEAR）作为当今打造智能家居和小型企业网络设备厂商，于 2019 年 5 月 25 日在深圳望海路海上世界文化艺术中心補时空间，发布全线 WiFi 6 产品即 RAX40、RAX80、RAX120、RAX200 四款产品，重新布局WiFi市场，新路由器支持下一代 Wi-Fi 标准—— 802.11ax，新名称为“Wi-Fi 6”，其可以更好地同时处理网络上的大量设备,这一点在现代充满智能小设备的家庭中变得越来越重要。与此同时美国网件宣布将打造 Home Heart 智品优选系列产品——智能数字艺术画框 Meural 以及三频 Mesh 分布式高速路由器系统 Orbi，布局全新无线智能家庭市场。", "gold": {"type": "产品行为-发布", "trigger": {"text": "发布", "start": 73, "end": 75}, "args": [{"text": "2019 年 5 月 25 日", "start": 37, "end": 52, "role": "时间"}, {"text": "美国网件（NETGEAR）", "start": 0, "end": 13, "role": "发布方"}, {"text": "全线 WiFi 6 产品即 RAX40", "start": 75, "end": 94, "role": "发布产品"}, {"text": "RAX80", "start": 95, "end": 100, "role": "发布产品"}, {"text": "RAX120", "start": 101, "end": 107, "role": "发布产品"}, {"text": "RAX200", "start": 108, "end": 114, "role": "发布产品"}]}, "events": [], "latency_ms": 279.3937919996097, "diagnostics": {"status": "ok", "wrapped_json": false, "unknown_type": 0, "unknown_role": 0, "unmatched_spans": 0, "raw": "{\"events\":[]}", "examples": [], "response_model": "default_model", "finish_reason": "stop", "prompt_tokens": 1266, "completion_tokens": 5}}
